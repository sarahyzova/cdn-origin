DATA_PATH=./data
DOMAIN_SUFFIX=localhost
PORT=3030
HTTPS=false
JWT_SECRET=set_a_strong_secret_key_here_or_remove_this_line_to_generate_one

# Production hardening (see docs/api.md)
NODE_ENV=production
# Shared secret Cloudflare must send on every request (via a Transform Rule) so the origin
# rejects traffic that bypasses it. Leave unset to allow direct access (e.g. local dev).
ORIGIN_SHARED_SECRET=
# Number of trusted reverse-proxy hops in front of this server (Cloudflare -> app is usually 1).
TRUST_PROXY=1
# How long (seconds) Cloudflare/browsers may cache a public object at the edge.
PUBLIC_CACHE_MAX_AGE_SECONDS=300
# Reject uploads larger than this many bytes. Leave unset for no limit.
MAX_UPLOAD_SIZE_BYTES=
# Optional: purge Cloudflare's edge cache automatically when a public object is deleted/overwritten.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Where to send visitors who hit the bare CDN domain's "/" (no bucket subdomain). Leave unset for a plain 404.
MAIN_PAGE_REDIRECT_URL=
